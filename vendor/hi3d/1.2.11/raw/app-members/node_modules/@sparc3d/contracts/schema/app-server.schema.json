{
  "allowedMethods": [
    "thread/start",
    "thread/resume",
    "thread/fork",
    "thread/read",
    "thread/list",
    "thread/archive",
    "thread/unarchive",
    "thread/name/set",
    "thread/metadata/update",
    "thread/compact/start",
    "turn/start",
    "turn/interrupt",
    "turn/steer",
    "thread/goal/get",
    "thread/goal/set",
    "thread/goal/clear",
    "model/list",
    "skills/list",
    "collaborationMode/list",
    "review/start",
    "account/rateLimits/read"
  ],
  "notifications": [
    "thread/started",
    "thread/status/changed",
    "skills/changed",
    "thread/name/updated",
    "thread/archived",
    "thread/tokenUsage/updated",
    "thread/goal/updated",
    "thread/goal/cleared",
    "turn/started",
    "turn/completed",
    "turn/diff/updated",
    "turn/plan/updated",
    "item/started",
    "item/completed",
    "item/agentMessage/delta",
    "item/plan/delta",
    "item/commandExecution/outputDelta",
    "item/fileChange/patchUpdated",
    "item/mcpToolCall/progress",
    "item/reasoning/summaryPartAdded",
    "item/reasoning/summaryTextDelta",
    "item/reasoning/textDelta",
    "account/rateLimits/updated",
    "serverRequest/resolved",
    "item/reasoning/*"
  ],
  "serverRequests": {
    "commandApproval": "item/commandExecution/requestApproval",
    "fileChangeApproval": "item/fileChange/requestApproval",
    "permissionsApproval": "item/permissions/requestApproval",
    "userInput": "item/tool/requestUserInput",
    "elicitation": "mcpServer/elicitation/request",
    "dynamicToolCall": "item/tool/call",
    "currentTime": "currentTime/read"
  },
  "hostInteractions": {
    "method": "interaction/request",
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "input",
            "preference",
            "confirmation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "skillCredit": {
          "type": "object",
          "properties": {
            "skill": {
              "type": "string",
              "enum": [
                "hi3d-model-gpt-animation",
                "image-to-assembly",
                "mask-design"
              ]
            },
            "credits": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "skill",
            "credits"
          ],
          "additionalProperties": false
        },
        "questions": {
          "default": [],
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "options": {
                "default": [],
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "defaultAnswer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "question",
              "options"
            ],
            "additionalProperties": false
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 600
        }
      },
      "required": [
        "kind",
        "title",
        "questions"
      ],
      "additionalProperties": false
    },
    "response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "answered",
            "defaulted",
            "declined",
            "cancelled"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "assistant_default"
          ]
        },
        "answers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "decline"
          ]
        }
      },
      "required": [
        "status",
        "source",
        "answers"
      ],
      "additionalProperties": false
    }
  },
  "responses": {
    "approval": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "acceptForSession",
            "decline",
            "cancel"
          ]
        }
      },
      "required": [
        "decision"
      ],
      "additionalProperties": false
    },
    "permissionsApproval": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "permissions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "scope": {
          "type": "string",
          "enum": [
            "turn",
            "session"
          ]
        }
      },
      "required": [
        "permissions",
        "scope"
      ],
      "additionalProperties": false
    },
    "userInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "answers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "answers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "answers"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "answers"
      ],
      "additionalProperties": false
    },
    "elicitation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "decline",
            "cancel"
          ]
        },
        "content": {},
        "_meta": {}
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "dynamicToolCall": {
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "callId": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "arguments": {}
        },
        "required": [
          "threadId",
          "turnId",
          "tool",
          "arguments"
        ],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "contentItems": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "inputText"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "inputImage"
                    },
                    "imageUrl": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "imageUrl"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "contentItems",
          "success"
        ],
        "additionalProperties": false
      }
    }
  }
}
