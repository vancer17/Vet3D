{
  "name": "@sparc3d/contracts",
  "version": "1.2.11",
  "private": true,
  "description": "View 层与 Runtime 层之间唯一的耦合点：stdio JSONL 信封、app-server 允许列表、Runtime 自有方法、Studio dynamic tools 定义",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    }
  },
  "files": [
    "src",
    "schema"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "schema": "tsx scripts/export-schema.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
