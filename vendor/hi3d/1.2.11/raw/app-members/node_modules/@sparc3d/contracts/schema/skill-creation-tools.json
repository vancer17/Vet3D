[
  {
    "name": "skill_draft_submit",
    "description": "Validate and freeze a Skill draft from skill-drafts/<name> in this conversation workspace. Does not install or execute it. Fix returned issues before resubmitting.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^skill-drafts\\/[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "exampleTask": {
          "type": "string",
          "maxLength": 4000
        },
        "mergedInstalledRevisionId": {
          "description": "Only after comparing and merging the current installed content into the workspace draft, supply that exact installed revision ID. Never use this to bypass an unresolved merge.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "skill_capture_suggest",
    "description": "Record a reusable completed workflow suggestion. Host decides whether to display it after this turn completes. Never claim the card is displayed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "steps": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        }
      },
      "required": [
        "title",
        "summary",
        "reason"
      ],
      "additionalProperties": false
    }
  }
]
