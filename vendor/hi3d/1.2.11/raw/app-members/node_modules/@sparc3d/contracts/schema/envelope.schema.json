{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "request"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {}
      },
      "required": [
        "type",
        "requestId",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "message": {
              "type": "string"
            },
            "data": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "requestId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notification"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {}
      },
      "required": [
        "type",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "serverRequest"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {}
      },
      "required": [
        "type",
        "requestId",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "serverResponse"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "message": {
              "type": "string"
            },
            "data": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "requestId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "phase"
        },
        "phase": {
          "type": "string",
          "enum": [
            "starting",
            "running",
            "degraded",
            "stopped"
          ]
        },
        "detail": {
          "type": "string"
        },
        "codex": {
          "type": "object",
          "properties": {
            "running": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "running"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "phase"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exit"
        },
        "component": {
          "type": "string",
          "enum": [
            "codex",
            "gateway"
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "type": [
            "string",
